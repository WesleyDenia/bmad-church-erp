# This file contains deployment configuration, never passwords or private keys.
# Copy it to deploy/.env and replace all placeholder values.
DEPLOY_SECRETS_DIR=/home/oem/Workspace/secrets
DEPLOY_BACKUP_DIR=/home/oem/Workspace/church-erp-backups
ACME_EMAIL=admin@example.com
DEV_DOMAIN=localhost
STG_DOMAIN=stg.example.com
PROD_DOMAIN=app.example.com
DEV_BFF_INTERNAL_BASE_URL=http://web-dev:3000
STG_BFF_INTERNAL_BASE_URL=http://web-stg:3000
PROD_BFF_INTERNAL_BASE_URL=http://web-prod:3000
DEV_DB_USERNAME=church_erp_dev
STG_DB_USERNAME=church_erp_stg
PROD_DB_USERNAME=church_erp_prod
